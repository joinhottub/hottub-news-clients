{
  "name": "hottub-news",
  "version": "0.1.0",
  "description": "Client and agent tools for Hottub News: worldwide news, deduplicated into stories across outlets and languages. Free, no key.",
  "keywords": ["news", "api", "mcp", "agents", "ai-sdk", "langchain", "llm", "tools", "rss", "gdelt"],
  "homepage": "https://hottub.news",
  "repository": { "type": "git", "url": "git+https://github.com/joinhottub/hottub-news-clients.git", "directory": "js" },
  "bugs": { "url": "https://github.com/joinhottub/hottub-news-clients/issues" },
  "author": "Hottub, Inc. (https://joinhottub.com)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./ai-sdk": { "types": "./dist/ai-sdk.d.ts", "import": "./dist/ai-sdk.js" },
    "./langchain": { "types": "./dist/langchain.d.ts", "import": "./dist/langchain.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "ai": ">=5.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": { "optional": true },
    "ai": { "optional": true },
    "zod": { "optional": true }
  },
  "devDependencies": {
    "@langchain/core": "^1.2.13",
    "@types/node": "^24.0.0",
    "ai": "^7.0.118",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  }
}
